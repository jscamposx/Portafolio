# Auto detect text files and perform LF normalization
* text=auto

# Ensure PDFs are always treated as binary
*.pdf binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.avif binary

# Fonts
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary

# Archives
*.zip binary
*.gz binary
*.tar binary
*.rar binary

# Videos
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary
