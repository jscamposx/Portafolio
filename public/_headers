# Headers para Render.com - Caché agresivo para sitio estático

# Páginas HTML - Cache con revalidación
/*
  Cache-Control: public, max-age=0, must-revalidate

# Assets estáticos - Cache por 1 año
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes - Cache por 1 año
/Proyectos/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker - Sin caché (debe actualizarse siempre)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Fuentes - Cache por 1 año
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# JavaScript y CSS - Cache por 1 año (con hash en el nombre)
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Favicon - Cache por 1 semana
/favicon.svg
  Cache-Control: public, max-age=604800
