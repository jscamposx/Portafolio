---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

// Datos inline
const siteName = 'Jesús Campos';
const pageTitle = `Proyectos | ${siteName}`;
const pageDescription = `${siteName} comparte casos de estudio y proyectos recientes.`;
---

<Layout title={pageTitle} description={pageDescription} showNav={false}>
  <!-- Botón flotante: Volver al inicio (fuera del section para que sea fixed respecto al viewport) -->
  <a 
    href="/" 
    data-astro-prefetch
    transition:name="back-to-home-button"
    class="group fixed bottom-4 right-4 z-50 flex items-center justify-center gap-3 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 shadow-lg backdrop-blur-xl transition-all duration-300 hover:scale-110 hover:border-[var(--color-accent)] hover:shadow-[0_12px_40px_-8px_rgba(var(--accent-rgb),0.5)] active:scale-95 sm:bottom-6 sm:right-6 sm:px-5 sm:py-5"
    title="Volver al inicio"
  >
    <!-- Icono solo en mobile, con texto en desktop hover -->
    <svg class="size-5 text-[var(--color-text-muted)] transition-all duration-300 group-hover:text-[var(--color-accent)] group-hover:-translate-x-1 sm:size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
    </svg>
    
    <!-- Texto (solo desktop hover) -->
    <span class="hidden text-sm font-bold text-[var(--color-text)] transition-all duration-300 group-hover:text-[var(--color-accent)] sm:inline sm:max-w-0 sm:overflow-hidden sm:whitespace-nowrap sm:opacity-0 sm:group-hover:max-w-[140px] sm:group-hover:opacity-100 sm:group-hover:ml-1">
      Volver al inicio
    </span>
    
    <!-- Efecto de brillo en hover -->
    <div class="pointer-events-none absolute inset-0 rounded-full bg-gradient-to-br from-[var(--color-accent)]/0 via-[var(--color-accent)]/15 to-[var(--color-accent)]/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
  </a>

  <section class="space-y-12 sm:space-y-16">
      <div class="flex items-center gap-3">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[var(--color-accent)]/30 to-transparent"></div>
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-[var(--color-accent)]">Portafolio</p>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[var(--color-accent)]/30 to-transparent"></div>
      </div>
      
      <div class="space-y-4 text-center">
        <h1 
          class="text-4xl font-bold sm:text-5xl lg:text-6xl bg-gradient-to-br from-[var(--color-heading)] to-[var(--color-text-muted)] bg-clip-text text-transparent"
          transition:name="all-projects-title"
        >
          Casos de estudio seleccionados
        </h1>
        <p class="max-w-3xl mx-auto text-base text-[var(--color-text-muted)] sm:text-lg leading-relaxed">
          Experiencias digitales pensadas de forma integral: investigación, diseño de interacción y desarrollo
          front-end listo para producción.
        </p>
      </div>
      
      <!-- Estadística decorativa -->
      <div class="flex justify-center gap-8 sm:gap-12 text-center pt-4">
        <div class="space-y-1">
          <div class="text-3xl sm:text-4xl font-bold text-[var(--color-accent)]">{projects.length}</div>
          <div class="text-xs sm:text-sm text-[var(--color-text-muted)] uppercase tracking-wider">Proyectos</div>
        </div>
        <div class="w-px bg-gradient-to-b from-transparent via-[var(--color-border)] to-transparent"></div>
        <div class="space-y-1">
          <div class="text-3xl sm:text-4xl font-bold text-[var(--color-accent)]">{new Date().getFullYear()}</div>
          <div class="text-xs sm:text-sm text-[var(--color-text-muted)] uppercase tracking-wider">Actualizado</div>
        </div>
      </div>
    </header>

    <!-- Grid de proyectos con stagger animation -->
    <div class="grid gap-8 sm:gap-10">
      {projects.map((project, index) => (
        <div 
          class="project-card-wrapper"
          style={`animation-delay: ${index * 100}ms`}
        >
          <a
            href={`/proyectos/${project.slug}`}
            class="block group/card"
            id={project.slug}
          >
            <ProjectCard
              project={project}
              compact
              isWrappedInLink={true}
              href={`/proyectos/${project.slug}`}
            />
          </a>
        </div>
      ))}
    </div>

    <!-- Footer decorativo -->
    <div class="pt-12 pb-8">
      <div class="flex items-center gap-3">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[var(--color-border)] to-[var(--color-border)]"></div>
        <span class="text-xs text-[var(--color-text-muted)] uppercase tracking-wider">Fin del portafolio</span>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent via-[var(--color-border)] to-[var(--color-border)]"></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .project-card-wrapper {
    animation: slide-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Optimización de performance */
  .project-card-wrapper {
    will-change: transform, opacity;
  }

  /* Optimización para View Transitions */
  @media (min-width: 769px) {
    /* Limitar el número de elementos con view-transition-name */
    .project-card-wrapper:nth-child(n+6) {
      view-transition-name: none !important;
    }
  }

  /* Deshabilitar animaciones en mobile para mejor performance */
  @media (max-width: 768px) {
    .project-card-wrapper {
      animation: none;
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in,
    .project-card-wrapper {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
