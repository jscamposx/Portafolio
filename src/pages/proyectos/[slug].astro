---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import TechChip from '../../components/TechChip.astro';

// Datos inline
const siteName = 'Jesús Campos';

const getProjectBySlug = (slug: string) => projects.find((p) => p.slug === slug);

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const slug = Astro.params.slug ?? '';

if (!slug) {
  return Astro.redirect('/proyectos');
}

const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect('/proyectos');
}

const metaTitle = `${project.title} | ${siteName}`;
const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<Layout
  title={metaTitle}
  description={project.description}
  showNav={false}
  preloadImage={project.heroImage}
>
  <!-- Navegación flotante fija -->
  <div class="fixed bottom-4 right-4 z-50 flex flex-col gap-3 sm:bottom-6 sm:right-6">
    <!-- Botón: Volver a proyectos -->
    <a
      href="/#proyectos"
      class="group relative flex items-center gap-3 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 shadow-lg backdrop-blur-xl transition-all hover:scale-105 hover:border-[var(--project-color)] hover:shadow-[0_0_20px_var(--project-color-alpha)]"
      title="Volver a proyectos"
    >
      <svg
        class="size-5 text-[var(--color-text-muted)] transition-all group-hover:text-[var(--project-color)] group-hover:-translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
      <span
        class="hidden sm:inline text-sm font-medium text-[var(--color-text)] sm:opacity-0 sm:max-w-0 overflow-hidden whitespace-nowrap transition-all duration-300 sm:group-hover:opacity-100 sm:group-hover:max-w-xs"
      >
        Volver
      </span>
    </a>

    <!-- Botón: Ver más proyectos -->
    <a
      href="/proyectos/"
      class="group relative flex items-center justify-center gap-3 rounded-full border px-4 py-3 shadow-lg backdrop-blur-xl transition-all hover:scale-105"
      style={`border-color: ${project.accent}50; background: linear-gradient(to right, ${project.accent}, ${project.accent}dd);`}
      title="Ver más proyectos"
    >
      <svg
        class="size-5 text-white transition-transform group-hover:rotate-90"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <span
        class="hidden sm:inline text-sm font-medium text-white sm:opacity-0 sm:max-w-0 overflow-hidden whitespace-nowrap transition-all duration-300 sm:group-hover:opacity-100 sm:group-hover:max-w-xs"
      >
        Más proyectos
      </span>
    </a>
  </div>

  <article
    class="space-y-16"
    style={`
      --project-color: ${project.accent};
      --project-color-alpha: ${project.accent}33;
      --project-color-bg: ${project.accent}1A;
      --project-color-border: ${project.accent}40;
    `}
  >
    <header class="relative space-y-8" style={`--project-accent: ${project.accent};`}>
      {
        project.technologies && project.technologies.length > 0 && (
          <div
            class="flex flex-wrap items-center gap-2"
            transition:name={`project-techs-${project.slug}`}
          >
            {project.technologies.map((tech) => (
              <TechChip name={tech} />
            ))}
          </div>
        )
      }
      <div class="space-y-4">
        <h1
          class="text-4xl font-semibold sm:text-5xl"
          transition:name={`project-title-${project.slug}`}
        >
          {project.title}
        </h1>
        <p class="max-w-3xl text-base text-[var(--color-text-muted)] sm:text-lg">
          {project.description}
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        {
          project.tags.map((tag) => (
            <span
              class="project-tag rounded-full border px-4 py-2 text-xs font-medium uppercase tracking-wide"
              style={`border-color: var(--project-color); background: var(--project-color-bg); color: var(--project-color);`}
            >
              {tag}
            </span>
          ))
        }
      </div>
      <div
        class="relative overflow-hidden rounded-2xl border border-[var(--color-border)] image-frame"
      >
        <div class="relative aspect-video">
          <img
            class="absolute inset-0 w-full h-full object-cover"
            src={project.heroImage}
            alt={`Mockup del proyecto ${project.title}`}
            decoding="async"
            loading="eager"
            transition:name={`project-image-${project.slug}`}
          />
        </div>
      </div>
      <div class="flex flex-wrap gap-4">
        {
          project.links.map((link) => (
            <a
              class="project-link group inline-flex items-center gap-2 rounded-full border surface-pill px-5 py-3 text-sm font-semibold backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
              href={link.url}
              target="_blank"
              rel="noreferrer"
            >
              {link.label.includes('sitio') || link.label.includes('Sitio') ? (
                <svg
                  class="size-4 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                  />
                </svg>
              ) : (
                <svg
                  class="size-4 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-12"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              )}
              <span>{link.label}</span>
              <span
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </header>

    {/* Secciones normales solo para proyectos que NO son Viadca ni FoodTech */}
    {
      project.slug !== 'viadca' && project.slug !== 'foodtech' && (
        <section class="space-y-8">
          {project.sections.map((section) => (
            <div class="project-section space-y-3 rounded-2xl border surface-card p-6 transition hover:-translate-y-0.5">
              <h2 class="text-xl font-semibold">{section.heading}</h2>
              <p class="text-base text-[var(--color-text-muted)]">{section.body}</p>
            </div>
          ))}
        </section>
      )
    }

    {/* Contenido especial para Viadca con imágenes */}
    {
      project.slug === 'viadca' && (
        <section class="space-y-8 sm:space-y-12">
          {/* Header de sección */}
          <div class="text-center space-y-3 sm:space-y-4">
            <h2 class="project-title text-2xl sm:text-3xl md:text-4xl font-bold bg-clip-text text-transparent">
              Dashboard Administrativo
            </h2>
            <p class="text-sm sm:text-base md:text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto px-4">
              Módulos especializados diseñados para optimizar cada aspecto de la gestión de viajes
            </p>
          </div>

          {/* Grid de módulos - Layout alternado */}
          <div class="space-y-10 sm:space-y-16">
            {/* Control de Usuarios - Imagen izquierda */}
            <div class="grid md:grid-cols-2 gap-4 sm:gap-8 items-center">
              <div class="project-card relative group overflow-hidden rounded-xl sm:rounded-2xl border p-1 transition-all duration-500 hover:shadow-2xl">
                <div class="relative overflow-hidden rounded-lg sm:rounded-xl bg-[var(--color-surface)]">
                  <img
                    class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
                    src="/Proyectos/viadca/viadca-users.avif"
                    alt="Panel de gestión de usuarios"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                </div>
              </div>

              <div class="space-y-3 sm:space-y-6">
                <div class="project-badge inline-flex items-center gap-2 sm:gap-3 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full border">
                  <svg
                    class="size-4 sm:size-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                    />
                  </svg>
                  <span class="text-xs sm:text-sm font-semibold">Gestión de Usuarios</span>
                </div>
                <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-[var(--color-text)]">
                  Control Total de Accesos
                </h3>
                <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
                  Sistema robusto de roles y permisos que permite configurar accesos granulares para
                  administradores, mayoristas y agentes.
                </p>
                <div class="grid grid-cols-3 gap-2 sm:gap-4">
                  <div class="project-stat p-2 sm:p-4 rounded-lg sm:rounded-xl bg-[var(--color-surface)] border transition-colors">
                    <p class="text-lg sm:text-2xl font-bold">3+</p>
                    <p class="text-[10px] sm:text-xs text-[var(--color-text-muted)] mt-1">Roles</p>
                  </div>
                  <div class="project-stat p-2 sm:p-4 rounded-lg sm:rounded-xl bg-[var(--color-surface)] border transition-colors">
                    <p class="text-lg sm:text-2xl font-bold">JWT</p>
                    <p class="text-[10px] sm:text-xs text-[var(--color-text-muted)] mt-1">
                      Seguridad
                    </p>
                  </div>
                  <div class="project-stat p-2 sm:p-4 rounded-lg sm:rounded-xl bg-[var(--color-surface)] border transition-colors">
                    <p class="text-lg sm:text-2xl font-bold">100%</p>
                    <p class="text-[10px] sm:text-xs text-[var(--color-text-muted)] mt-1">
                      Control
                    </p>
                  </div>
                </div>
              </div>
            </div>

            {/* Gestión de Tareas - Imagen derecha */}
            <div class="grid md:grid-cols-2 gap-4 sm:gap-8 items-center">
              <div class="space-y-3 sm:space-y-6 md:order-1">
                <div class="project-badge inline-flex items-center gap-2 sm:gap-3 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full border">
                  <svg
                    class="size-4 sm:size-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                    />
                  </svg>
                  <span class="text-xs sm:text-sm font-semibold">Gestión de Tareas</span>
                </div>
                <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-[var(--color-text)]">
                  Monitor de Actividades
                </h3>
                <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
                  Sistema completo para rastrear y gestionar todas las tareas del equipo, con
                  historial detallado, estados en tiempo real y asignaciones por usuario.
                </p>
                <ul class="space-y-2 sm:space-y-3">
                  <li class="flex items-start gap-2 sm:gap-3">
                    <>
                      <div class="project-checkmark mt-0.5 sm:mt-1 p-1 rounded-full bg-[var(--project-color-bg)]">
                        <svg
                          class="size-3 sm:size-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                      </div>
                      <span class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                        Historial completo de tareas realizadas
                      </span>
                    </>
                  </li>
                  <li class="flex items-start gap-2 sm:gap-3">
                    <>
                      <div class="project-checkmark mt-0.5 sm:mt-1 p-1 rounded-full bg-[var(--project-color-bg)]">
                        <svg
                          class="size-3 sm:size-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                      </div>
                      <span class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                        Estados y prioridades visuales
                      </span>
                    </>
                  </li>
                  <li class="flex items-start gap-2 sm:gap-3">
                    <>
                      <div class="project-checkmark mt-0.5 sm:mt-1 p-1 rounded-full bg-[var(--project-color-bg)]">
                        <svg
                          class="size-3 sm:size-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                      </div>
                      <span class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                        Asignación y seguimiento por usuario
                      </span>
                    </>
                  </li>
                </ul>
              </div>
              <div class="project-card relative group overflow-hidden rounded-xl sm:rounded-2xl border p-1 transition-all duration-500 hover:shadow-2xl md:order-2">
                <div class="relative overflow-hidden rounded-lg sm:rounded-xl bg-[var(--color-surface)]">
                  <img
                    class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
                    src="/Proyectos/viadca/viadca-task.avif"
                    alt="Monitor de tareas y actividades"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                </div>
              </div>
            </div>

            {/* Grid 2x2 para las últimas 3 imágenes */}
            <div class="grid md:grid-cols-2 gap-4 sm:gap-8">
              <div class="project-card group relative overflow-hidden rounded-xl sm:rounded-2xl border p-4 sm:p-6 transition-all duration-500 hover:shadow-2xl">
                <div class="space-y-2 sm:space-y-4 mb-4 sm:mb-6">
                  <div class="project-badge inline-flex items-center gap-2 px-3 py-1.5 rounded-full border">
                    <svg
                      class="size-3 sm:size-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      />
                    </svg>
                    <span class="text-xs sm:text-sm font-semibold">Formularios</span>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text)]">
                    Validación Inteligente
                  </h3>
                  <p class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                    Feedback en tiempo real con mensajes contextuales
                  </p>
                </div>
                <div class="relative overflow-hidden rounded-lg sm:rounded-xl">
                  <img
                    class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
                    src="/Proyectos/viadca/viadca-form.avif"
                    alt="Formularios dinámicos"
                    loading="lazy"
                  />
                </div>
              </div>

              <div class="project-card group relative overflow-hidden rounded-xl sm:rounded-2xl border p-4 sm:p-6 transition-all duration-500 hover:shadow-2xl">
                <div class="space-y-2 sm:space-y-4 mb-4 sm:mb-6">
                  <div class="project-badge inline-flex items-center gap-2 px-3 py-1.5 rounded-full border">
                    <svg
                      class="size-3 sm:size-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      />
                    </svg>
                    <span class="text-xs sm:text-sm font-semibold">Recuperación</span>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text)]">
                    Papelera Segura
                  </h3>
                  <p class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                    Recuperación de datos con un solo clic
                  </p>
                </div>
                <div class="relative overflow-hidden rounded-lg sm:rounded-xl">
                  <img
                    class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
                    src="/Proyectos/viadca/viadca-trash.avif"
                    alt="Sistema de papelera"
                    loading="lazy"
                  />
                </div>
              </div>

              <div class="project-card md:col-span-2 group relative overflow-hidden rounded-xl sm:rounded-2xl border transition-all duration-500 hover:shadow-2xl">
                <div class="grid md:grid-cols-2 gap-4 sm:gap-6 p-4 sm:p-6">
                  <div class="space-y-3 sm:space-y-6">
                    <div class="project-badge inline-flex items-center gap-2 px-3 py-1.5 rounded-full border">
                      <svg
                        class="size-3 sm:size-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <>
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </>
                      </svg>
                      <span class="text-xs sm:text-sm font-semibold">Configuración</span>
                    </div>
                    <h3 class="text-lg sm:text-2xl font-bold text-[var(--color-text)]">
                      Panel de Control Total
                    </h3>
                    <p class="text-xs sm:text-base text-[var(--color-text-muted)] leading-relaxed">
                      Personalización completa de branding, SEO, emails y permisos desde un panel
                      centralizado.
                    </p>
                    <div class="grid grid-cols-2 gap-2 sm:gap-3">
                      <div class="project-stat flex items-center gap-2 p-2 sm:p-3 rounded-lg bg-[var(--color-surface)] border">
                        <>
                          <svg
                            class="size-4 sm:size-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                            />
                          </svg>
                          <span class="text-[10px] sm:text-xs font-medium text-[var(--color-text)]">
                            Branding
                          </span>
                        </>
                      </div>
                      <div class="project-stat flex items-center gap-2 p-2 sm:p-3 rounded-lg bg-[var(--color-surface)] border">
                        <>
                          <svg
                            class="size-4 sm:size-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            />
                          </svg>
                          <span class="text-[10px] sm:text-xs font-medium text-[var(--color-text)]">
                            SEO
                          </span>
