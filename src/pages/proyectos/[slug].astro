---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import TechChip from '../../components/TechChip.astro';

// Datos inline
const siteName = 'Jesús Campos';

const getProjectBySlug = (slug: string) => projects.find(p => p.slug === slug);

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const slug = Astro.params.slug ?? '';

if (!slug) {
  return Astro.redirect('/proyectos');
}

const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect('/proyectos');
}

const metaTitle = `${project.title} | ${siteName}`;
const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
---

<Layout title={metaTitle} description={project.description} showNav={false}>
  <!-- Navegación flotante fija -->
  <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3">
    <!-- Botón: Volver a proyectos -->
    <a 
      href="/#proyectos"
      class="group relative flex items-center gap-3 rounded-full border border-[var(--color-border)] surface-card px-4 py-3 shadow-lg backdrop-blur-xl transition-all hover:scale-105 hover:border-[var(--color-accent)] hover:shadow-[0_0_20px_rgba(192,132,252,0.3)]"
      title="Volver a proyectos"
      transition:persist="project-nav-back"
    >
      <svg class="size-5 text-[var(--color-text-muted)] transition-all group-hover:text-[var(--color-accent)] group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <span class="hidden sm:inline text-sm font-medium text-[var(--color-text)] sm:opacity-0 sm:max-w-0 overflow-hidden whitespace-nowrap transition-all duration-300 sm:group-hover:opacity-100 sm:group-hover:max-w-xs">
        Volver
      </span>
    </a>

    <!-- Botón: Ver más proyectos -->
    <a 
      href="/proyectos/"
      class="group relative flex items-center justify-center gap-3 rounded-full border border-[var(--color-accent)]/30 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-strong)] px-4 py-3 shadow-lg backdrop-blur-xl transition-all hover:scale-105 hover:shadow-[0_0_25px_rgba(192,132,252,0.5)]"
      title="Ver más proyectos"
      transition:persist="project-nav-more"
    >
      <svg class="size-5 text-white transition-transform group-hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <span class="hidden sm:inline text-sm font-medium text-white sm:opacity-0 sm:max-w-0 overflow-hidden whitespace-nowrap transition-all duration-300 sm:group-hover:opacity-100 sm:group-hover:max-w-xs">
        Más proyectos
      </span>
    </a>
  </div>

  <article class="space-y-16">
    <header
      class="relative space-y-8"
      style={`--project-accent: ${project.accent};`}
      transition:name={`project-card-${project.slug}`}
    >
      {project.technologies && project.technologies.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          {project.technologies.map((tech) => (
            <span 
              transition:name={`project-tech-${project.slug}-${tech.toLowerCase().replace(/\s+/g, '-')}`}
            >
              <TechChip name={tech} />
            </span>
          ))}
        </div>
      )}
      <div class="space-y-4">
        <h1 class="text-4xl font-semibold sm:text-5xl" transition:name={`project-title-${project.slug}`}>{project.title}</h1>
        <p class="max-w-3xl text-base text-[var(--color-text-muted)] sm:text-lg">{project.description}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        {project.tags.map((tag) => (
            <span class="rounded-full border border-[var(--color-border)] surface-pill px-4 py-2 text-xs font-medium uppercase tracking-wide text-[var(--color-text)]" transition:name={`project-tag-${project.slug}-${slugify(tag)}`}>
            {tag}
          </span>
        ))}
      </div>
      <div class="relative overflow-hidden rounded-2xl border border-[var(--color-border)] image-frame transition-all duration-500" transition:name={`project-image-wrapper-${project.slug}`}>
        <img
          class="aspect-video w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.02]"
          src={project.heroImage}
          alt={`Mockup del proyecto ${project.title}`}
          loading="lazy"
          transition:name={`project-image-${project.slug}`}
        />
      </div>
      <div class="flex flex-wrap gap-4">
          {project.links.map((link) => (
            <a
              class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] surface-pill px-5 py-3 text-sm font-semibold text-[var(--color-text)] backdrop-blur transition hover:-translate-y-0.5 hover:border-[rgba(192,132,252,0.45)]"
              href={link.url}
              target="_blank"
              rel="noreferrer"
              transition:animate="fade"
            >
              {link.label}
              <span aria-hidden="true">→</span>
            </a>
          ))}
      </div>
    </header>

    <section class="space-y-8">
      {project.sections.map((section) => (
        <div
          class="space-y-3 rounded-2xl border border-[var(--color-border)] surface-card p-6 transition hover:-translate-y-0.5"
          transition:name={`case-section-${slugify(section.heading)}`}
        >
          <h2 class="text-xl font-semibold text-white">{section.heading}</h2>
          <p class="text-base text-[var(--color-text-muted)]">{section.body}</p>
        </div>
      ))}
    </section>
  </article>
</Layout>

