<!-- Modal para imagen en pantalla completa -->
<div id="imageModal" class="image-modal">
  <img id="modalImage" src="" alt="Vista ampliada" />
  <button class="image-modal-close" aria-label="Cerrar imagen">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
      ></path>
    </svg>
  </button>
</div>

<script>
  // Funcionalidad del modal de imagen
  function initImageModal() {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage') as HTMLImageElement;
    const closeBtn = document.querySelector('.image-modal-close');

    if (!modal || !modalImage) return;

    // Limpiar listeners anteriores si existen
    const oldModalClickHandler = (modal as any).__modalClickHandler;
    if (oldModalClickHandler) {
      modal.removeEventListener('click', oldModalClickHandler);
    }

    const oldCloseHandler = (closeBtn as any).__closeHandler;
    if (oldCloseHandler) {
      closeBtn?.removeEventListener('click', oldCloseHandler);
    }

    const oldKeyHandler = (window as any).__imageModalKeyHandler;
    if (oldKeyHandler) {
      document.removeEventListener('keydown', oldKeyHandler);
    }

    // Función para abrir el modal
    function openImageModal(imageSrc: string, imageAlt: string) {
      if (modalImage && modal) {
        modalImage.src = imageSrc;
        modalImage.alt = imageAlt;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    // Función para cerrar el modal
    function closeImageModal() {
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    // Agregar event listeners a todas las imágenes dentro de .project-card
    const projectImages = document.querySelectorAll('.project-card img');

    projectImages.forEach((img) => {
      const imageElement = img as HTMLImageElement;
      // Limpiar listener anterior si existe
      const oldHandler = (imageElement as any).__imageClickHandler;
      if (oldHandler) {
        imageElement.removeEventListener('click', oldHandler);
      }

      const imageClickHandler = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        openImageModal(imageElement.src, imageElement.alt);
      };
      (imageElement as any).__imageClickHandler = imageClickHandler;
      imageElement.addEventListener('click', imageClickHandler);
    });

    // Cerrar modal al hacer clic en el botón de cerrar
    const closeHandler = () => closeImageModal();
    (closeBtn as any).__closeHandler = closeHandler;
    closeBtn?.addEventListener('click', closeHandler);

    // Cerrar modal al hacer clic fuera de la imagen
    const modalClickHandler = (e: Event) => {
      if (e.target === modal) {
        closeImageModal();
      }
    };
    (modal as any).__modalClickHandler = modalClickHandler;
    modal.addEventListener('click', modalClickHandler);

    // Cerrar modal con la tecla ESC
    const keyHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeImageModal();
      }
    };
    (window as any).__imageModalKeyHandler = keyHandler;
    document.addEventListener('keydown', keyHandler);
  }

  // Inicializar cuando la página carga
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageModal);
  } else {
    initImageModal();
  }

  // Reinicializar después de las view transitions de Astro
  document.addEventListener('astro:page-load', initImageModal);
</script>
