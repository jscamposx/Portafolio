---
// Tipos locales mínimos para evitar errores de compilación
interface Project {
  slug: string;
  title: string;
  description: string;
  year: number;
  client?: string;
  tags: string[];
  heroImage: string;
  accent: string;
}

interface Props {
  project: Project;
  compact?: boolean;
  href?: string;
  isWrappedInLink?: boolean; // Nueva prop para saber si ya está dentro de un <a>
}

const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const { project, compact = false, href, isWrappedInLink = false } = Astro.props as Props;
const projectUrl = href ?? `/proyectos/${project.slug}/?ref=home`;
---

<article
  class:list={[
    'group/card relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-500 ease-out hover:border-[var(--color-accent)]/40 sm:p-8',
    compact && 'sm:p-6',
    'hover:shadow-[0_20px_60px_rgba(0,0,0,0.3)] hover:shadow-[var(--color-accent)]/10',
    'before:absolute before:inset-0 before:rounded-3xl before:bg-gradient-to-br before:from-[var(--color-accent)]/0 before:to-[var(--color-accent)]/0 before:opacity-0 before:transition-opacity before:duration-500 hover:before:opacity-100 hover:before:from-[var(--color-accent)]/5 hover:before:to-transparent'
  ]}
  data-transition="project-card"
  style={`--card-accent: ${project.accent};`}
  transition:name={`project-card-${project.slug}`}
>
  <!-- Efecto de luz que sigue el cursor -->
  <div class="pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover/card:opacity-100" 
       style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(var(--accent-rgb), 0.06), transparent 40%);"></div>

  <div class="relative flex flex-col gap-6 z-10">
    <!-- Imagen mejorada con overlay gradient -->
    <div 
      class="relative overflow-hidden rounded-2xl border border-[var(--color-border)] image-frame group-hover/card:border-[var(--color-accent)]/30 transition-all duration-500"
    >
      <!-- Overlay gradient sutil -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 z-10"></div>
      
      <img
        class="aspect-video w-full object-cover transition-all duration-700 ease-out group-hover/card:scale-105 group-hover/card:brightness-110"
        src={project.heroImage}
        alt={`Vista previa del proyecto ${project.title}`}
        loading="lazy"
        transition:name={`project-image-${project.slug}`}
      />
      
      <!-- Badge decorativo en la imagen -->
      <div class="absolute top-4 right-4 z-20 opacity-0 group-hover/card:opacity-100 transition-all duration-300 transform translate-x-2 group-hover/card:translate-x-0">
        <div class="rounded-full bg-[var(--color-accent)] px-3 py-1.5 text-xs font-bold text-white shadow-lg backdrop-blur-sm">
          Ver detalles
        </div>
      </div>
    </div>

    <!-- Meta info mejorada -->
    <div class="flex flex-wrap items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.2em]">
      <span class="flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-gradient-to-br from-[var(--color-surface-alt)] to-transparent px-3 py-1.5 text-[var(--color-text-muted)] transition-all duration-300 group-hover/card:border-[var(--color-accent)]/40 group-hover/card:text-[var(--color-accent)]">
        <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        {project.year}
      </span>
      {project.client && (
        <span class="rounded-full border border-[var(--color-border)] bg-gradient-to-br from-[var(--color-surface-alt)] to-transparent px-3 py-1.5 text-[var(--color-text-muted)] transition-all duration-300 group-hover/card:border-[var(--color-accent)]/40 group-hover/card:text-[var(--color-accent)]">
          {project.client}
        </span>
      )}
    </div>

    <!-- Contenido principal -->
    <div class="space-y-3">
      <h3 
        class="text-2xl sm:text-3xl font-bold text-[var(--color-heading)] transition-all duration-300 group-hover/card:text-[var(--color-accent)] group-hover/card:translate-x-1"
        transition:name={`project-title-${project.slug}`}
      >
        {project.title}
      </h3>
      <p class="text-base leading-relaxed text-[var(--color-text-muted)] transition-colors duration-300 group-hover/card:text-[var(--color-text)]">
        {project.description}
      </p>
    </div>

    <!-- Tags mejorados -->
    <div class="flex flex-wrap gap-2">
      {(project.tags || []).map((tag) => (
        <span 
          class="group/tag rounded-xl border border-[var(--color-border)] bg-gradient-to-br from-[var(--color-surface-alt)] to-transparent px-3 py-1.5 text-xs font-medium uppercase tracking-wide text-[var(--color-text)] transition-all duration-300 ease-out hover:border-[var(--color-accent)]/60 hover:bg-[var(--color-accent)]/10 hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--color-accent)]/20" 
          transition:name={`project-tag-${project.slug}-${slugify(tag)}`}
        >
          {tag}
        </span>
      ))}
    </div>

    <!-- Link mejorado con icono animado -->
    {!isWrappedInLink && (
      <div class="pt-2">
        <a
          class="group/link inline-flex items-center gap-2.5 text-sm font-bold text-[var(--color-accent)] transition-all duration-300 hover:gap-4"
          href={projectUrl}
          transition:name={`project-link-${project.slug}`}
        >
          <span class="relative">
            Ver caso completo
            <span class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-accent)] transition-all duration-300 group-hover/link:w-full"></span>
          </span>
          <svg class="size-5 transition-transform duration-300 group-hover/link:translate-x-1 group-hover/link:-translate-y-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M8.5 5H19v10.5m0-10.5-14 14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    )}
  </div>
</article>

<script>
  // Efecto de seguimiento del cursor (solo en desktop)
  if (window.matchMedia('(min-width: 1024px)').matches) {
    const cards = document.querySelectorAll('[data-transition="project-card"]');
    
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }
</script>
