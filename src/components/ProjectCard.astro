---



// Tipos locales mínimos para evitar errores de compilación
interface Project {
  slug: string;
  title: string;
  description: string;
  year: number;
  client?: string;
  tags: string[];
  heroImage: string;
  accent: string;
}

interface Props {
  project: Project;
  compact?: boolean;
  href?: string;
  isWrappedInLink?: boolean; // Nueva prop para saber si ya está dentro de un <a>
}

const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const { project, compact = false, href, isWrappedInLink = false } = Astro.props as Props;
const projectUrl = href ?? `/proyectos/${project.slug}/?ref=home`;
---

<article
  class:list={[
  'group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-500 ease-out transform-gpu hover:-translate-y-2 sm:p-8',
    compact && 'sm:p-6'
  ]}
  data-transition="project-card"
  style={`--card-accent: ${project.accent};`}
  transition:name={`project-card-${project.slug}`}
>

  <div class="relative flex flex-col gap-5">
  <div class="relative overflow-hidden rounded-2xl border border-[var(--color-border)] image-frame transition-all duration-500" transition:name={`project-image-wrapper-${project.slug}`}>
      <img
        class="h-56 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        src={project.heroImage}
        alt={`Vista previa del proyecto ${project.title}`}
        loading="lazy"
        transition:name={`project-image-${project.slug}`}
      />
    </div>

    <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-text-muted)]">
  <span class="rounded-full border border-[var(--color-border)] surface-pill px-3 py-1 transition-all duration-300">{project.year}</span>
      {project.client && (
  <span class="rounded-full border border-[var(--color-border)] surface-pill px-3 py-1 transition-all duration-300">{project.client}</span>
      )}
    </div>

    <div class="space-y-3">
      <h3 class="text-2xl font-semibold text-white transition-transform duration-300 group-hover:translate-x-1" transition:name={`project-title-${project.slug}`}>{project.title}</h3>
      <p class="text-base text-[var(--color-text-muted)] transition-opacity duration-300 group-hover:opacity-90">{project.description}</p>
    </div>

    <div class="flex flex-wrap gap-2">
      {(project.tags || []).map((tag) => (
  <span class="rounded-full border border-[var(--color-border)] surface-pill px-3 py-1 text-xs font-medium uppercase tracking-wide text-[var(--color-text)] transition-transform duration-300 ease-out group-hover:-translate-y-0.5" transition:name={`project-tag-${project.slug}-${slugify(tag)}`}>
          {tag}
        </span>
      ))}
    </div>

    {!isWrappedInLink && (
      <a
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] transition-all duration-300 hover:gap-3 hover:text-[var(--color-text)]"
        href={projectUrl}
        transition:name={`project-link-${project.slug}`}
      >
        Ver caso completo
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M8.5 5H19v10.5m0-10.5-14 14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )}
  </div>
</article>
