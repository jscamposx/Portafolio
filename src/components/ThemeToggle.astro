---
// Componente standalone para el botón de cambio de tema
---

<div
  class="fixed top-4 right-4 z-[9999] transition-opacity duration-300"
  transition:name="standalone-theme-toggle"
>
  <div class="relative">
    <button
      id="theme-toggle-btn-standalone"
      class="appearance-none border-none flex items-center justify-center rounded-full p-3 bg-[var(--nav-surface-bg)] border border-[var(--nav-surface-border)] backdrop-blur-xl shadow-lg text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] hover:scale-110 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
      aria-label="Elegir tema"
      title="Cambiar tema"
      type="button"
    >
      <span class="sr-only">Cambiar tema</span>
      <svg
        id="light-standalone"
        class="theme-toggle-icon size-5 transition-all"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="scale:0"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
        <path
          d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"
        ></path>
      </svg>
      <svg
        id="dark-standalone"
        class="theme-toggle-icon absolute size-5 transition-all"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="scale:1"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"
        ></path>
      </svg>
      <svg
        id="system-standalone"
        class="theme-toggle-icon absolute size-5 transition-all"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="scale:0"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z"
        ></path>
        <path d="M7 20h10"></path>
        <path d="M9 16v4"></path>
        <path d="M15 16v4"></path>
      </svg>
    </button>
    <div
      id="themes-menu-standalone"
      class="theme-menu hidden absolute top-14 right-0 text-xs p-1 min-w-[8rem] rounded-md border border-[var(--color-border)] bg-[var(--nav-surface-bg)] backdrop-blur-xl shadow-[0_4px_18px_-4px_rgba(0,0,0,0.35)]"
    >
      <ul class="py-1">
        <li
          data-theme-option="light"
          class="themes-menu-option px-2 py-1.5 rounded-sm cursor-default hover:bg-[var(--color-surface-alt)]"
        >
          Light
        </li>
        <li
          data-theme-option="dark"
          class="themes-menu-option px-2 py-1.5 rounded-sm cursor-default hover:bg-[var(--color-surface-alt)]"
        >
          Dark
        </li>
        <li
          data-theme-option="system"
          class="themes-menu-option px-2 py-1.5 rounded-sm cursor-default hover:bg-[var(--color-surface-alt)]"
        >
          System
        </li>
      </ul>
    </div>
  </div>
</div>

<script>
  if (typeof window !== 'undefined') {
    const initStandaloneTheme = () => {
      const themesMenu = document.getElementById('themes-menu-standalone');
      const toggleBtn = document.getElementById('theme-toggle-btn-standalone');

      if (!themesMenu || !toggleBtn) return;

      const mm = window.matchMedia('(prefers-color-scheme: dark)');
      let removeMedia: (() => void) | null = null;

      const getThemePreference = (): 'light' | 'dark' | 'system' => {
        try {
          return (localStorage.getItem('theme') as any) || 'system';
        } catch {
          return 'system';
        }
      };

      const updateIcon = (pref: string) => {
        // Actualizar iconos del botón standalone
        const standaloneIcons = ['light-standalone', 'dark-standalone', 'system-standalone'];
        standaloneIcons.forEach((id) => {
          const el = document.getElementById(id);
          if (el) {
            (el as HTMLElement).style.scale = id === `${pref}-standalone` ? '1' : '0';
          }
        });

        // Actualizar opciones del menú
        document.querySelectorAll('#themes-menu-standalone .themes-menu-option').forEach((opt) => {
          opt.classList.toggle('active', (opt as HTMLElement).dataset.themeOption === pref);
        });
      };

      const applyTheme = () => {
        if (removeMedia) removeMedia();
        mm.addEventListener('change', applyTheme, { once: true });
        removeMedia = () => mm.removeEventListener('change', applyTheme);
        const pref = getThemePreference();
        const isDark = pref === 'dark' || (pref === 'system' && mm.matches);
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.dataset.theme = pref;
        updateIcon(pref);
      };

      applyTheme();

      // Limpiar listeners anteriores
      const oldClickHandler = (window as any).__standaloneThemeClickHandler;
      if (oldClickHandler) {
        document.removeEventListener('click', oldClickHandler);
      }

      // Handler de click global para cerrar el menú
      const clickHandler = (e: MouseEvent) => {
        if (!themesMenu || !toggleBtn) return;
        // Si el click es dentro del menú o del botón, no hacer nada
        if (themesMenu.contains(e.target as Node) || toggleBtn.contains(e.target as Node)) return;
        // Cerrar el menú
        themesMenu.classList.add('hidden');
        themesMenu.classList.remove('open');
      };
      (window as any).__standaloneThemeClickHandler = clickHandler;
      document.addEventListener('click', clickHandler);

      // Limpiar listener del botón anterior
      const oldToggleBtnHandler = (window as any).__standaloneThemeToggleBtnHandler;
      if (oldToggleBtnHandler) {
        toggleBtn.removeEventListener('click', oldToggleBtnHandler);
      }

      // Handler del botón toggle
      const toggleBtnHandler = (e: MouseEvent) => {
        e.stopPropagation();
        if (!themesMenu) return;
        const opening = themesMenu.classList.contains('hidden');
        themesMenu.classList.toggle('hidden');
        if (opening) {
          themesMenu.classList.add('open');
        } else {
          themesMenu.classList.remove('open');
        }
      };
      (window as any).__standaloneThemeToggleBtnHandler = toggleBtnHandler;
      toggleBtn.addEventListener('click', toggleBtnHandler);

      // Opciones del menú
      themesMenu.querySelectorAll('.themes-menu-option').forEach((opt) => {
        const oldHandler = (opt as any).__standaloneThemeOptionHandler;
        if (oldHandler) {
          opt.removeEventListener('click', oldHandler);
        }

        const optionHandler = () => {
          const pref = (opt as HTMLElement).dataset.themeOption as 'light' | 'dark' | 'system';
          try {
            localStorage.setItem('theme', pref);
          } catch {}
          applyTheme();
          themesMenu.classList.add('hidden');
          themesMenu.classList.remove('open');
        };
        (opt as any).__standaloneThemeOptionHandler = optionHandler;
        opt.addEventListener('click', optionHandler);
      });

      // Activar transiciones de tema
      requestAnimationFrame(() => {
        document.documentElement.classList.remove('pre-theme');
        document.documentElement.classList.add('theme-transition');
        setTimeout(() => document.documentElement.classList.remove('theme-transition'), 1000);
      });
    };

    // Inicializar
    initStandaloneTheme();

    // Reinicializar después de navegaciones
    document.addEventListener('astro:after-swap', () => {
      setTimeout(() => initStandaloneTheme(), 50);
    });
  }
</script>
