---
// Datos inline (Contact)
const contact = {
  eyebrow: 'Contacto',
  title: '¿Hablamos de tu proyecto?',
  description:
    'Estoy disponible para nuevas oportunidades y colaboraciones. Si tienes un proyecto en mente o simplemente quieres conectar, no dudes en escribirme.',
  email: 'jscamposx@gmail.com',
  social: [
    { name: 'LinkedIn', href: 'https://www.linkedin.com/in/jscamposx', icon: 'linkedin' },
    { name: 'GitHub', href: 'https://github.com/jscamposx', icon: 'github' }
  ]
};
---

<section id="contacto" class="pt-10 sm:pt-24 space-y-8 sm:space-y-12 px-3 sm:px-0">
  <header class="space-y-2 sm:space-y-4 max-w-3xl">
    <p
      class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)]"
    >
      {contact.eyebrow}
    </p>
    <h2 class="text-xl sm:text-4xl font-semibold">{contact.title}</h2>
    <p class="text-xs sm:text-lg text-[var(--color-text-muted)]">{contact.description}</p>
  </header>

  <div class="grid md:grid-cols-2 gap-6 sm:gap-12 max-w-5xl">
    <!-- Información de contacto -->
    <div class="space-y-5 sm:space-y-6">
      <div class="space-y-3 sm:space-y-4">
        <h3 class="text-base sm:text-lg font-semibold text-[var(--color-heading)]">
          Información de contacto
        </h3>

        <a
          href={`mailto:${contact.email}`}
          class="group flex items-center gap-3 p-3 sm:p-4 rounded-xl bg-[var(--card-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--color-accent)]/10"
        >
          <div
            class="flex-shrink-0 w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-strong)] flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
          >
            <svg
              class="w-4 h-4 sm:w-5 sm:h-5 text-white transition-transform duration-300 group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[10px] sm:text-xs text-[var(--color-text-muted)] mb-0.5">Email</p>
            <p
              class="text-xs sm:text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors truncate"
            >
              {contact.email}
            </p>
          </div>
          <svg
            class="w-4 h-4 sm:w-5 sm:h-5 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 transition-all"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </a>
      </div>

      <div class="space-y-3">
        <h3 class="text-base sm:text-lg font-semibold text-[var(--color-heading)]">
          Redes sociales
        </h3>
        <div class="flex flex-col gap-2">
          {
            contact.social.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 p-3 rounded-lg hover:bg-[var(--color-surface-alt)] transition-all duration-300 hover:-translate-x-1"
              >
                <div class="w-8 h-8 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] flex items-center justify-center group-hover:border-[var(--color-accent)] transition-all duration-300 group-hover:scale-110 group-hover:rotate-6">
                  {link.icon === 'linkedin' ? (
                    <svg
                      class="w-4 h-4 text-[var(--color-accent)] transition-transform duration-300 group-hover:scale-110"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  ) : (
                    <svg
                      class="w-4 h-4 text-[var(--color-accent)] transition-transform duration-300 group-hover:scale-110"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                  )}
                </div>
                <span class="text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
                  {link.name}
                </span>
                <svg
                  class="ml-auto w-4 h-4 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)] group-hover:translate-x-1 transition-all duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Decoración visual -->
      <div
        class="hidden md:block mt-8 p-6 rounded-xl bg-gradient-to-br from-[var(--color-accent)]/10 to-[var(--color-accent-strong)]/5 border border-[var(--color-accent)]/20"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="w-10 h-10 rounded-full bg-[var(--color-accent)] flex items-center justify-center"
          >
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h4 class="text-sm font-semibold text-[var(--color-heading)]">Respuesta rápida</h4>
        </div>
        <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
          Normalmente respondo en menos de 24 horas. Si es urgente, contáctame directamente por
          LinkedIn.
        </p>
      </div>
    </div>

    <!-- Formulario de contacto -->
    <div class="relative">
      <form
        id="contact-form"
        class="space-y-5 p-6 sm:p-8 rounded-2xl bg-[var(--card-surface)] border border-[var(--color-border)] backdrop-blur-sm"
      >
        <div class="space-y-2">
          <label for="name" class="block text-sm font-medium text-[var(--color-text)]">
            Nombre <span class="text-[var(--color-accent)]">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Tu nombre completo"
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
          />
          <span class="error-message hidden text-xs text-red-500 mt-1"></span>
        </div>

        <div class="space-y-2">
          <label for="email" class="block text-sm font-medium text-[var(--color-text)]">
            Email <span class="text-[var(--color-accent)]">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="tu@email.com"
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
          />
          <span class="error-message hidden text-xs text-red-500 mt-1"></span>
        </div>

        <div class="space-y-2">
          <label for="subject" class="block text-sm font-medium text-[var(--color-text)]">
            Asunto <span class="text-[var(--color-accent)]">*</span>
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            placeholder="¿Sobre qué quieres hablar?"
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all"
          />
          <span class="error-message hidden text-xs text-red-500 mt-1"></span>
        </div>

        <div class="space-y-2">
          <label for="message" class="block text-sm font-medium text-[var(--color-text)]">
            Mensaje <span class="text-[var(--color-accent)]">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="Cuéntame más sobre tu proyecto o idea..."
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] focus:border-transparent transition-all resize-none"
          ></textarea>
          <span class="error-message hidden text-xs text-red-500 mt-1"></span>
        </div>

        <button
          type="submit"
          class="w-full group/btn relative px-6 py-3.5 rounded-xl bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-strong)] text-white font-semibold hover:shadow-lg hover:shadow-[var(--color-accent)]/30 hover:scale-[1.02] focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent)] disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 transition-all duration-300"
        >
          <span class="flex items-center justify-center gap-2">
            <span class="submit-text">Enviar mensaje</span>
            <svg
              class="w-5 h-5 transition-transform duration-300 group-hover/btn:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </span>
          <!-- Spinner de carga -->
          <span class="loading-spinner absolute inset-0 hidden items-center justify-center">
            <svg
              class="animate-spin h-5 w-5 text-white"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </span>
        </button>

        <!-- Mensaje de estado -->
        <div id="form-message" class="hidden"></div>
      </form>
      
      <!-- Toast de notificación -->
      <div
        id="toast-notification"
        class="fixed bottom-20 left-1/2 -translate-x-1/2 z-[10000] max-w-md w-[calc(100%-2rem)] pointer-events-none"
        style="transform: translate(-50%, 200px); opacity: 0; transition: all 0.5s ease-out;"
      >
        <div
          class="flex items-start gap-3 p-4 rounded-xl shadow-2xl backdrop-blur-xl border pointer-events-auto"
          id="toast-content"
        >
          <div class="flex-shrink-0" id="toast-icon"></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold" id="toast-title"></p>
            <p class="text-xs mt-1 opacity-90" id="toast-message"></p>
          </div>
          <button
            id="toast-close"
            class="flex-shrink-0 ml-auto rounded-lg p-1 hover:bg-white/10 transition-colors"
            aria-label="Cerrar notificación"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Efecto de brillo decorativo -->
      <div
        class="absolute -inset-1 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-strong)] rounded-2xl opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500 -z-10 pointer-events-none"
      >
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    const submitText = submitBtn?.querySelector('.submit-text') as HTMLElement;
    const loadingSpinner = submitBtn?.querySelector('.loading-spinner') as HTMLElement;

    if (!form || !submitBtn) return;

    // Validación en tiempo real
    const inputs = form.querySelectorAll('input, textarea');
    inputs.forEach((input) => {
      input.addEventListener('blur', () =>
        validateField(input as HTMLInputElement | HTMLTextAreaElement)
      );
      input.addEventListener('input', () => {
        const errorMsg = input.parentElement?.querySelector('.error-message');
        if (errorMsg && !errorMsg.classList.contains('hidden')) {
          validateField(input as HTMLInputElement | HTMLTextAreaElement);
        }
      });
    });

    function validateField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
      const errorMsg = field.parentElement?.querySelector('.error-message') as HTMLElement;
      let isValid = true;
      let message = '';

      if (field.hasAttribute('required') && !field.value.trim()) {
        isValid = false;
        message = 'Este campo es obligatorio';
      } else if (field.type === 'email' && field.value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(field.value)) {
          isValid = false;
          message = 'Por favor, introduce un email válido';
        }
      } else if (field.id === 'message' && field.value.trim().length < 10) {
        isValid = false;
        message = 'El mensaje debe tener al menos 10 caracteres';
      }

      if (errorMsg) {
        if (isValid) {
          errorMsg.classList.add('hidden');
          field.classList.remove('!border-red-500');
        } else {
          errorMsg.textContent = message;
          errorMsg.classList.remove('hidden');
          field.classList.add('!border-red-500');
        }
      }

      return isValid;
    }

    function showMessage(message: string, type: 'success' | 'error') {
      const toast = document.getElementById('toast-notification');
      const toastContent = document.getElementById('toast-content');
      const toastIcon = document.getElementById('toast-icon');
      const toastTitle = document.getElementById('toast-title');
      const toastMessage = document.getElementById('toast-message');
      const toastClose = document.getElementById('toast-close');

      if (!toast || !toastContent || !toastIcon || !toastTitle || !toastMessage) {
        console.error('Toast elements not found');
        // Fallback: usar alert
        alert(message);
        return;
      }

      console.log('Showing toast:', type, message);

      // Configurar según el tipo
      if (type === 'success') {
        toastContent.className =
          'flex items-start gap-3 p-4 rounded-xl shadow-2xl backdrop-blur-xl border border-purple-500/30 bg-purple-500/10 text-purple-100 pointer-events-auto';
        toastIcon.innerHTML = `
          <div class="w-8 h-8 rounded-lg bg-purple-500 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        `;
        toastTitle.textContent = '¡Mensaje enviado!';
        toastMessage.textContent = message;
      } else {
        toastContent.className =
          'flex items-start gap-3 p-4 rounded-xl shadow-2xl backdrop-blur-xl border border-red-500/30 bg-red-500/10 text-red-100 pointer-events-auto';
        toastIcon.innerHTML = `
          <div class="w-8 h-8 rounded-lg bg-red-500 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
        `;
        toastTitle.textContent = 'Error al enviar';
        toastMessage.textContent = message;
      }

      // Mostrar toast con animación usando estilos inline
      toast.style.transform = 'translate(-50%, 0)';
      toast.style.opacity = '1';

      // Función para cerrar el toast
      const closeToast = () => {
        toast.style.transform = 'translate(-50%, 200px)';
        toast.style.opacity = '0';
      };

      // Cerrar automáticamente después de 5 segundos
      const autoCloseTimeout = setTimeout(() => {
        closeToast();
      }, 5000);

      // Botón de cerrar
      if (toastClose) {
        toastClose.onclick = () => {
          closeToast();
          clearTimeout(autoCloseTimeout);
        };
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validar todos los campos
      let isFormValid = true;
      inputs.forEach((input) => {
        if (!validateField(input as HTMLInputElement | HTMLTextAreaElement)) {
          isFormValid = false;
        }
      });

      if (!isFormValid) {
        showMessage('Por favor, corrige los errores en el formulario', 'error');
        return;
      }

      // Deshabilitar botón y mostrar spinner
      submitBtn.disabled = true;
      submitText.classList.add('invisible');
      loadingSpinner.classList.remove('hidden');
      loadingSpinner.classList.add('flex');

      // Recoger datos del formulario
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        subject: formData.get('subject'),
        message: formData.get('message')
      };

      try {
        // Enviar formulario usando Formspree
        const response = await fetch('https://formspree.io/f/mzzkkjnb', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          showMessage('¡Mensaje enviado correctamente! Te responderé pronto.', 'success');
          form.reset();
        } else {
          throw new Error('Error al enviar el mensaje');
        }
      } catch (error) {
        console.error('Error:', error);
        showMessage(
          'Hubo un error al enviar el mensaje. Por favor, intenta contactarme directamente por email.',
          'error'
        );
      } finally {
        // Rehabilitar botón y ocultar spinner
        submitBtn.disabled = false;
        submitText.classList.remove('invisible');
        loadingSpinner.classList.add('hidden');
        loadingSpinner.classList.remove('flex');
      }
    });
  });
</script>

<style>
  /* Animación suave para los campos de entrada */
  input:focus,
  textarea:focus {
    transform: translateY(-1px);
  }

  /* Estilo personalizado para el scrollbar del textarea */
  textarea::-webkit-scrollbar {
    width: 8px;
  }

  textarea::-webkit-scrollbar-track {
    background: var(--color-surface);
    border-radius: 4px;
  }

  textarea::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }

  textarea::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent);
  }

  /* Animación del spinner */
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }

  /* Toast notification centrado en bottom */
  #toast-notification {
    bottom: 5rem;
  }

  /* Responsive para el toast */
  @media (max-width: 640px) {
    #toast-notification {
      bottom: 4rem;
      width: calc(100% - 2rem);
      max-width: calc(100% - 2rem);
    }
  }
</style>
