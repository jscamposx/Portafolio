---
// Datos inline (Contact)
const eyebrow = 'Contacto';
const title = 'Hablemos de tu proyecto';
const description = 'Estoy disponible para nuevos proyectos y colaboraciones. Cuéntame qué tienes en mente.';
---
<section id="contacto" class="space-y-8 sm:space-y-12 pt-12 sm:pt-16 px-4 sm:px-0" transition:animate="fade">
  <header class="space-y-3 sm:space-y-4">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)]">{eyebrow}</p>
    <h2 class="text-2xl font-semibold sm:text-4xl">{title}</h2>
    <p class="max-w-3xl text-sm sm:text-base text-[var(--color-text-muted)]">{description}</p>
  </header>
  <div class="max-w-3xl space-y-6 sm:space-y-8">
    <!-- Formulario principal -->
    <form 
      id="contact-form" 
      class="group relative p-6 sm:p-8 lg:p-10 rounded-2xl sm:rounded-3xl border border-purple-200/20 dark:border-[var(--color-border)] bg-gradient-to-br from-[rgba(19,11,30,0.95)] to-[rgba(29,17,45,0.9)] backdrop-blur-md shadow-2xl"
      action="https://formspree.io/f/xovqzkby"
      method="POST"
    >
      <!-- Efecto de glow al hacer focus -->
      <div class="pointer-events-none absolute inset-0 rounded-[inherit] opacity-0 group-focus-within:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle at 30% 20%, rgba(192,132,252,0.2), transparent 65%);"></div>
      
      <!-- Campos del formulario -->
      <div class="relative space-y-5 sm:space-y-6">
        <!-- Grid: Nombre y Email -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
          <div class="flex flex-col gap-2.5">
            <label for="name" class="text-sm font-semibold tracking-wide text-purple-100">
              Nombre <span class="text-[var(--color-accent)]">*</span>
            </label>
            <input 
              id="name" 
              name="name" 
              type="text" 
              required 
              autocomplete="name" 
              placeholder="Tu nombre completo" 
              class="peer h-12 rounded-xl border border-purple-300/20 bg-[rgba(29,17,45,0.7)] px-4 py-3 text-sm text-purple-50 placeholder:text-purple-300/50 outline-none transition-all focus:border-[rgba(192,132,252,0.7)] focus:ring-2 focus:ring-[rgba(192,132,252,0.25)] focus:bg-[rgba(29,17,45,0.9)] hover:border-[rgba(192,132,252,0.5)]" 
            />
          </div>
          <div class="flex flex-col gap-2.5">
            <label for="email" class="text-sm font-semibold tracking-wide text-purple-100">
              Email <span class="text-[var(--color-accent)]">*</span>
            </label>
            <input 
              id="email" 
              name="email" 
              type="email" 
              required 
              autocomplete="email" 
              placeholder="tucorreo@ejemplo.com" 
              class="peer h-12 rounded-xl border border-purple-300/20 bg-[rgba(29,17,45,0.7)] px-4 py-3 text-sm text-purple-50 placeholder:text-purple-300/50 outline-none transition-all focus:border-[rgba(192,132,252,0.7)] focus:ring-2 focus:ring-[rgba(192,132,252,0.25)] focus:bg-[rgba(29,17,45,0.9)] hover:border-[rgba(192,132,252,0.5)]" 
            />
          </div>
        </div>
        
        <!-- Asunto -->
        <div class="flex flex-col gap-2.5">
          <label for="subject" class="text-sm font-semibold tracking-wide text-purple-100">
            Asunto <span class="text-[var(--color-accent)]">*</span>
          </label>
          <input 
            id="subject" 
            name="subject" 
            type="text" 
            required 
            placeholder="¿De qué quieres hablar?" 
            class="peer h-12 rounded-xl border border-purple-300/20 bg-[rgba(29,17,45,0.7)] px-4 py-3 text-sm text-purple-50 placeholder:text-purple-300/50 outline-none transition-all focus:border-[rgba(192,132,252,0.7)] focus:ring-2 focus:ring-[rgba(192,132,252,0.25)] focus:bg-[rgba(29,17,45,0.9)] hover:border-[rgba(192,132,252,0.5)]" 
          />
        </div>
        
        <!-- Mensaje -->
        <div class="flex flex-col gap-2.5">
          <label for="message" class="text-sm font-semibold tracking-wide text-purple-100">
            Mensaje <span class="text-[var(--color-accent)]">*</span>
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="7" 
            required 
            placeholder="Cuéntame más sobre tu proyecto, ideas o cualquier pregunta que tengas..." 
            class="peer resize-y min-h-[200px] rounded-xl border border-purple-300/20 bg-[rgba(29,17,45,0.7)] px-4 py-3.5 text-sm leading-relaxed text-purple-50 placeholder:text-purple-300/50 outline-none transition-all focus:border-[rgba(192,132,252,0.7)] focus:ring-2 focus:ring-[rgba(192,132,252,0.25)] focus:bg-[rgba(29,17,45,0.9)] hover:border-[rgba(192,132,252,0.5)]"
          ></textarea>
        </div>
        
        <!-- Botones y estado -->
        <div class="pt-4 flex flex-col sm:flex-row items-center gap-4 justify-between border-t border-purple-300/10 mt-6 sm:mt-8">
          <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            <button 
              type="submit" 
              class="group/btn relative inline-flex items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-strong)] px-8 py-3.5 text-sm font-bold text-white transition-all active:scale-[.97] hover:-translate-y-1 hover:shadow-[0_10px_30px_-10px_rgba(192,132,252,0.6)] disabled:opacity-60 disabled:pointer-events-none overflow-hidden"
            >
              <div class="absolute inset-0 bg-white/20 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-300"></div>
              <span class="submit-text relative z-10">Enviar mensaje</span>
              <svg class="submit-text relative z-10 w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
              <span class="hidden submit-spinner relative z-10 size-4 animate-spin rounded-full border-2 border-white border-r-transparent"></span>
            </button>
            <button 
              type="reset" 
              class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-purple-300/20 px-6 py-3 text-sm font-semibold tracking-wide text-purple-200 transition-all hover:text-purple-100 hover:border-[rgba(192,132,252,0.5)] hover:bg-[rgba(192,132,252,0.05)] active:scale-[.97]"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Limpiar
            </button>
          </div>
          <p class="form-status text-sm font-medium text-purple-300 w-full sm:w-auto text-center sm:text-right"></p>
        </div>
      </div>
    </form>

    <!-- Información alternativa de contacto -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 p-6 rounded-xl border border-purple-200/20 bg-[rgba(19,11,30,0.6)] backdrop-blur-sm">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center size-10 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/30">
          <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs font-medium text-purple-300 uppercase tracking-wider">O escríbeme directo a</p>
          <a 
            class="text-sm font-semibold text-purple-100 hover:text-[var(--color-accent)] transition-colors underline decoration-dotted decoration-[var(--color-accent)]/40 underline-offset-4" 
            href="mailto:jscamposx@gmail.com"
          >
            jscamposx@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    if (typeof window !== 'undefined') {
      const initContactForm = () => {
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        if (!form) return;
        
        const statusEl = form.querySelector('.form-status') as HTMLElement | null;
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const spinner = form.querySelector('.submit-spinner') as HTMLElement | null;
        const submitText = form.querySelector('.submit-text') as HTMLElement | null;
        
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }
          
          if (submitBtn) submitBtn.disabled = true;
          if (spinner) spinner.classList.remove('hidden');
          if (submitText) submitText.textContent = 'Enviando...';
          if (statusEl) statusEl.textContent = '';

          try {
            const formData = new FormData(form);
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });
            
            if (response.ok) {
              if (statusEl) {
                statusEl.textContent = '✓ Mensaje enviado. Te responderé pronto.';
                statusEl.classList.add('text-green-400');
              }
              form.reset();
              
              // Ocultar mensaje de éxito después de 5 segundos
              setTimeout(() => {
                if (statusEl) {
                  statusEl.textContent = '';
                  statusEl.classList.remove('text-green-400');
                }
              }, 5000);
            } else {
              throw new Error('Error en la respuesta del servidor');
            }
          } catch (err) {
            if (statusEl) {
              statusEl.textContent = '✗ Error al enviar. Intenta de nuevo o escríbeme directo.';
              statusEl.classList.add('text-red-400');
            }
            
            setTimeout(() => {
              if (statusEl) {
                statusEl.textContent = '';
                statusEl.classList.remove('text-red-400');
              }
            }, 5000);
          } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (spinner) spinner.classList.add('hidden');
            if (submitText) submitText.textContent = 'Enviar mensaje';
          }
        });
      };
      
      initContactForm();
      
      // Reinicializar después de navegaciones con View Transitions
      document.addEventListener('astro:after-swap', () => {
        initContactForm();
      });
    }
  </script>
</section>
