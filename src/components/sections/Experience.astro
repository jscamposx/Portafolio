---
// Datos inline
const eyebrow = 'Trayectoria';
const title = 'Experiencia laboral';
const description = 'Acompaño a equipos de producto, marketing y tecnología para lanzar experiencias digitales con impacto medible.';
const items = [
  {
    period: '2024 — 2025',
    role: 'Desarrollador de Aplicación',
    company: 'Viadca',
    description: 'Diseñé y desarrollé una aplicación orientada a mejorar la eficiencia en la gestión y creación de viajes. Contribuí en diseño UI/UX, implementación frontend y backend, y despliegue en AWS, logrando optimizar procesos clave del negocio.'
  },
  {
    period: '2023 — 2024',
    role: 'Desarrollador de Aplicación E-commerce',
    company: 'Yola',
    description: 'Diseñé y desarrollé una plataforma de comercio electrónico para un restaurante, gestionando platillos, usuarios, eventos y pagos. Contribuí en el diseño UI/UX, desarrollo frontend y backend, integración de pasarelas de pago y despliegue en AWS, optimizando la experiencia de compra y la gestión de operaciones.'
  },
  {
    period: '2021 — 2023',
    role: 'Desarrollador Full Stack Junior',
    company: 'ITD',
    description: 'Diseñé y desarrollé un sitio web para la administración de egresados, con el objetivo de agilizar procesos de citas y gestión de proyectos de residencia. Contribuí en diseño UI/UX, desarrollo frontend y backend, y despliegue en AWS, mejorando la eficiencia en la gestión académica.'
  }
];
---
<section id="experiencia" class="space-y-8 sm:space-y-10 pt-12 sm:pt-16 px-4 sm:px-0" transition:animate="fade">
  <header class="space-y-3 sm:space-y-4">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)]">{eyebrow}</p>
    <h2 class="text-2xl font-semibold sm:text-4xl">{title}</h2>
    <p class="max-w-3xl text-sm text-[var(--color-text-muted)] sm:text-lg">{description}</p>
  </header>

  <ol class="relative space-y-8 before:absolute before:left-[18px] before:top-6 before:h-[calc(100%-3rem)] before:w-px before:bg-[var(--timeline-line,rgba(192,132,252,0.25))] before:content-[''] sm:space-y-12 md:space-y-16">
    {items.map((item) => (
      <li class="relative pl-12 sm:pl-14">
        <div class="absolute left-0 top-1 flex h-8 w-8 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-[color:var(--experience-dot-bg,rgba(192,132,252,0.2))] text-base sm:text-lg font-semibold text-[var(--color-accent)] shadow-[0_15px_45px_-25px_rgba(192,132,252,0.55)]">
          •
        </div>
        <div class="space-y-2 sm:space-y-3 rounded-2xl sm:rounded-3xl border border-[var(--color-border)] surface-card p-4 sm:p-6 transition hover:-translate-y-1 hover:border-[rgba(192,132,252,0.45)]">
          <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm text-[var(--color-text-muted)]">
            <span class="text-xs sm:text-sm font-semibold uppercase tracking-[0.24em] text-[var(--color-accent)]">{item.role}</span>
            <time class="text-[10px] sm:text-xs uppercase tracking-[0.18em] text-[var(--color-text-muted)]">{item.period}</time>
          </div>
          <h3 class="text-xl sm:text-2xl font-semibold text-[var(--color-text)]">{item.company}</h3>
          <p class="text-sm sm:text-base text-[var(--color-text-muted)]">{item.description}</p>
          {/* Enlace removido según solicitud (antes: item.link) */}
        </div>
      </li>
    ))}
  </ol>
</section>
