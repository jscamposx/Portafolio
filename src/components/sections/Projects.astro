---
import { projects } from '../../data/projects';
import TechChip from '../TechChip.astro';

// Datos inline
const eyebrow = 'Proyectos destacados';
const title = 'Resultados reales junto a equipos valientes';
const description = 'Sistemas de diseño, landings, aplicaciones internas y experimentos que aceleraron objetivos de negocio.';
const cta = { label: 'Ver todos los proyectos', href: '/proyectos/' };
---
<section id="proyectos" class="pt-16 sm:pt-24 space-y-12 sm:space-y-16 px-4 sm:px-0" transition:animate="fade">
  <header class="space-y-3 sm:space-y-4">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)]">{eyebrow}</p>
    <h2 class="text-2xl font-semibold sm:text-4xl">{title}</h2>
    <p class="max-w-3xl text-sm text-[var(--color-text-muted)] sm:text-lg">{description}</p>
  </header>

  <div class="space-y-16 sm:space-y-20">
    {projects.map((project) => {
      const techs = project.technologies || [];
      const codeLink = project.links?.find(l => /repo|git/i.test(l.label));
      const previewLink = project.links?.find(l => !/repo|git/i.test(l.label));
      const projectUrl = `/proyectos/${project.slug}`;
      return (
  <article
    class="flex flex-col md:flex-row md:items-start gap-6 sm:gap-10 group scroll-mt-32"
    id={project.slug}
  >
          <div class="w-full md:w-[460px] lg:w-[500px]">
            <div class="relative overflow-hidden rounded-xl border border-[var(--color-border)] transition-transform duration-500 group-hover:-translate-y-1" transition:name={`project-image-wrapper-${project.slug}`}>
              <div class="relative h-48 sm:h-56 md:h-64 overflow-hidden rounded-[11px] image-frame">
                <img
                  src={project.heroImage}
                  alt={`Vista previa del proyecto ${project.title}`}
                  class="object-cover object-center w-full h-full transition-transform duration-[1600ms] ease-out group-hover:scale-[1.04]"
                  loading="lazy"
                  transition:name={`project-image-${project.slug}`}
                />
              </div>
            </div>
          </div>
          <div class="flex-1 max-w-xl">
            <h3 class="text-xl sm:text-[1.55rem] font-semibold text-white leading-snug" transition:name={`project-title-${project.slug}`}>{project.title}</h3>
            {/* Chips de tecnologías */}
            {techs.length > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-2" transition:name={`project-techs-${project.slug}`}>
                {techs.map((tech) => (
                  <TechChip name={tech} />
                ))}
              </div>
            )}
            <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed text-[15px]">{project.description}</p>
            {/* Lista inferior de tecnologías eliminada (ya se muestran arriba) */}
            <div class="flex flex-wrap items-center mt-6 gap-3">
              {codeLink && (
                <a target="_blank" href={codeLink.url} role="link" class="inline-flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium rounded-xl bg-[var(--color-accent)] text-white border border-[var(--color-accent)] hover:bg-[var(--color-accent-strong)] hover:border-[var(--color-accent-strong)] focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent-chip-ring)] transition">
                  <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg>
                  Código
                </a>
              )}
              {previewLink && (
                <a target="_blank" href={previewLink.url} role="link" class="inline-flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium rounded-xl bg-[var(--color-accent)] text-white border border-[var(--color-accent)] hover:bg-[var(--color-accent-strong)] hover:border-[var(--color-accent-strong)] focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent-chip-ring)] transition">
                  <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  Preview
                </a>
              )}
              <a href={projectUrl} class="inline-flex items-center justify-center gap-2 px-3 py-2 text-sm font-medium rounded-xl bg-[var(--color-accent)] text-white border border-[var(--color-accent)] hover:bg-[var(--color-accent-strong)] hover:border-[var(--color-accent-strong)] focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent-chip-ring)] transition">
                Detalles
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 5H19v10.5m0-10.5-14 14"/></svg>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div class="flex justify-end pt-6">
    <a
      class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-[var(--color-accent)] text-white border border-[var(--color-accent)] hover:bg-[var(--color-accent-strong)] hover:border-[var(--color-accent-strong)] focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent-chip-ring)] text-sm font-medium transition"
      href={cta.href}
    >
      {cta.label}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.5 5H19v10.5m0-10.5-14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>
