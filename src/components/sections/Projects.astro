---
import { projects } from '../../data/projects';
import TechChip from '../TechChip.astro';

// Datos inline
const eyebrow = 'Proyectos destacados';
const title = 'Resultados reales junto a equipos valientes';
const description = 'Sistemas de diseño, landings, aplicaciones internas y experimentos que aceleraron objetivos de negocio.';
const cta = { label: 'Ver todos los proyectos', href: '/proyectos/' };

// Limitar a solo los primeros 3 proyectos para el home
const featuredProjects = projects.slice(0, 3);
---
<section id="proyectos" class="pt-10 sm:pt-24 space-y-8 sm:space-y-16 px-3 sm:px-0">
  <header class="space-y-2 sm:space-y-4">
    <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)]">{eyebrow}</p>
    <h2 class="text-xl sm:text-4xl font-semibold text-[var(--color-heading)]">{title}</h2>
    <p class="max-w-3xl text-xs sm:text-lg text-[var(--color-text-muted)] leading-relaxed">{description}</p>
  </header>

  <div class="space-y-12 sm:space-y-24">
    {featuredProjects.map((project, index) => {
      const techs = project.technologies || [];
      const codeLink = project.links?.find(l => /repo|git/i.test(l.label));
      const previewLink = project.links?.find(l => !/repo|git/i.test(l.label));
      const projectUrl = `/proyectos/${project.slug}`;
      const isFirst = index === 0;
      const isEven = index % 2 === 0;
      return (
  <article
    class="group/project relative scroll-mt-32 cursor-pointer"
    id={project.slug}
    data-project-url={projectUrl}
  >
    <!-- Layout grid responsivo con mejor distribución -->
    <div class={`grid md:grid-cols-2 gap-4 md:gap-8 lg:gap-12 items-center ${!isEven ? 'md:grid-flow-dense' : ''}`}>
      
      <!-- Imagen del proyecto -->
      <a href={projectUrl} data-astro-prefetch class={`relative block ${!isEven ? 'md:col-start-2' : ''}`}>
        <div class="relative overflow-hidden rounded-2xl border border-[var(--color-border)] transition-all duration-500 group-hover/project:border-[var(--color-accent)]/40 group-hover/project:shadow-2xl group-hover/project:shadow-[var(--color-accent)]/10 md:group-hover/project:-translate-y-2">
          
          <!-- Glow effect decorativo -->
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-strong)] opacity-0 blur-xl transition-all duration-500 group-hover/project:opacity-20"></div>
          
          <div class="relative aspect-video overflow-hidden rounded-[15px] bg-[var(--color-surface)]">
            <img
              src={project.heroImage}
              alt={`Vista previa del proyecto ${project.title}`}
              class="absolute inset-0 w-full h-full object-cover object-center transition-all duration-700 ease-out md:group-hover/project:scale-105"
              decoding="async"
              loading={isFirst ? "eager" : "lazy"}
              transition:name={`project-image-${project.slug}`}
            />
            
            <!-- Overlay gradient en hover -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover/project:opacity-100"></div>
          </div>
        </div>
      </a>

      <!-- Contenido del proyecto -->
      <div class="space-y-5">
        <!-- Título -->
        <a href={projectUrl} data-astro-prefetch>
          <h3 
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[var(--color-heading)] leading-tight transition-all duration-300 group-hover/project:text-[var(--color-accent)] hover:text-[var(--color-accent)]" 
            transition:name={`project-title-${project.slug}`}
          >
            {project.title}
          </h3>
        </a>

        <!-- Descripción -->
        <p class="text-[var(--color-text-muted)] leading-relaxed text-base sm:text-lg">
          {project.description}
        </p>

        <!-- Chips de tecnologías -->
        {techs.length > 0 && (
          <div class="flex flex-wrap items-center gap-2" transition:name={`project-techs-${project.slug}`}>
            {techs.map((tech) => (
              <TechChip name={tech} />
            ))}
          </div>
        )}

        <!-- Botones de acción mejorados -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {codeLink && (
            <a 
              target="_blank" 
              href={codeLink.url} 
              class="group/btn inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] transition-all duration-300"
            >
              <svg class="size-4 transition-transform duration-300 group-hover/btn:rotate-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>
              </svg>
              Código
            </a>
          )}
          {previewLink && (
            <a 
              target="_blank" 
              href={previewLink.url} 
              class="group/btn inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] transition-all duration-300"
            >
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
              Preview
            </a>
          )}
          <a 
            href={projectUrl} 
            class="group/btn inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-xl bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-strong)] text-white border-none hover:shadow-lg hover:shadow-[var(--color-accent)]/30 hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent)] transition-all duration-300"
          >
            Ver detalles
            <svg class="size-4 transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8.5 5H19v10.5m0-10.5-14 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>
      );
    })}
  </div>

  <div class="flex justify-center sm:justify-end pt-8">
    <a
      class="group/cta inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-strong)] text-white font-bold shadow-lg shadow-[var(--color-accent)]/20 hover:shadow-xl hover:shadow-[var(--color-accent)]/40 hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent)] text-sm sm:text-base transition-all duration-300"
      href={cta.href}
      data-astro-prefetch
      transition:name="all-projects-cta"
    >
      <span>{cta.label}</span>
      <svg class="size-5 transition-transform duration-300 group-hover/cta:translate-x-1 group-hover/cta:-translate-y-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M8.5 5H19v10.5m0-10.5-14 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

<style>
  /* Optimización para transiciones de proyectos */
  @media (min-width: 769px) {
    article {
      view-transition-name: none;
    }
  }

  /* Cursor pointer para el proyecto completo */
  article.group\/project {
    cursor: pointer;
  }

  /* Botones mantienen su propio cursor */
  article.group\/project a[class*="group/btn"],
  article.group\/project a[target="_blank"] {
    cursor: pointer;
    position: relative;
    z-index: 10;
  }
</style>

<script>
  // Script para hacer clickeable todo el card del proyecto
  document.addEventListener('astro:page-load', () => {
    const projectCards = document.querySelectorAll('article[data-project-url]');
    
    projectCards.forEach(card => {
      card.addEventListener('click', (e) => {
        // Verificar si el click fue en un botón o enlace
        const target = e.target as HTMLElement;
        const isButton = target.closest('a[class*="group/btn"]') || target.closest('a[target="_blank"]');
        
        if (!isButton) {
          e.preventDefault();
          const url = card.getAttribute('data-project-url');
          if (url) {
            // Crear un enlace temporal para aprovechar las view transitions de Astro
            const tempLink = document.createElement('a');
            tempLink.href = url;
            tempLink.setAttribute('data-astro-prefetch', '');
            tempLink.style.display = 'none';
            document.body.appendChild(tempLink);
            tempLink.click();
            document.body.removeChild(tempLink);
          }
        }
      });
    });
  });
</script>
