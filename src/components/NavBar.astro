---
// Navegación estática inline (se eliminó siteConfig)
const navLinks = [
  { label: 'Inicio', href: '/#hero' },
  { label: 'Experiencia', href: '/#experiencia' },
  { label: 'Proyectos', href: '/#proyectos' },
  { label: 'Contacto', href: '/#contacto' }
];
---

<header class="fixed top-0 z-50 flex w-full justify-center mt-2 px-2" transition:name="main-header">
  <nav
    class="nav-surface flex flex-wrap items-center justify-center rounded-full px-2.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-medium gap-0.5 sm:gap-2 max-w-fit"
  >
    <!-- Links de navegación -->
    <div class="flex flex-wrap items-center justify-center gap-0.5 sm:gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-2 sm:px-3 py-1.5 rounded-full nav-link text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[rgba(255,255,255,0.06)] transition-all duration-300 hover:-translate-y-0.5 whitespace-nowrap text-[11px] sm:text-sm"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Theme toggle -->
    <div class="relative ml-0.5 sm:ml-1" data-theme-toggle>
      <button
        data-theme-toggle-btn
        class="appearance-none border-none flex items-center justify-center rounded-full p-1.5 sm:p-2 hover:scale-110 transition-all duration-300 text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] hover:rotate-12 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        aria-label="Elegir tema"
        title="Cambiar tema"
        type="button"
      >
        <span class="sr-only">Cambiar tema</span>
        <svg
          data-theme-icon="light"
          class="theme-toggle-icon size-4 transition-all duration-300"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="scale:0"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
          <path
            d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"
          ></path>
        </svg>
        <svg
          data-theme-icon="dark"
          class="theme-toggle-icon absolute size-4 transition-all"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="scale:1"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"
          ></path>
        </svg>
        <svg
          data-theme-icon="system"
          class="theme-toggle-icon absolute size-4 transition-all"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="scale:0"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z"
          ></path>
          <path d="M7 20h10"></path>
          <path d="M9 16v4"></path>
          <path d="M15 16v4"></path>
        </svg>
      </button>
      <div
        data-theme-menu
        class="theme-menu hidden absolute top-9 right-0 text-xs p-1 min-w-[8rem] rounded-md border border-[var(--color-border)] bg-[var(--nav-surface-bg)] backdrop-blur-xl shadow-[0_4px_18px_-4px_rgba(0,0,0,0.35)]"
      >
        <ul class="py-1">
          <li
            data-theme-option="light"
            class="themes-menu-option px-2 py-1.5 rounded-sm cursor-default hover:bg-[var(--color-surface-alt)]"
          >
            Light
          </li>
          <li
            data-theme-option="dark"
            class="themes-menu-option px-2 py-1.5 rounded-sm cursor-default hover:bg-[var(--color-surface-alt)]"
          >
            Dark
          </li>
          <li
            data-theme-option="system"
            class="themes-menu-option px-2 py-1.5 rounded-sm cursor-default hover:bg-[var(--color-surface-alt)]"
          >
            System
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script type="module">
  import { initThemeToggleSystem } from '../scripts/themeToggle';

  if (typeof window !== 'undefined') {
    // ================== NAVIGATION ACTIVE STATE ==================
    // Evitar múltiples inicializaciones solo para la navegación
    if (!window.__navInit) {
      window.__navInit = true;

      const STATE = {
        header: null,
        hero: null,
        sections: [],
        links: [],
        current: '',
        retries: 0
      };

      const SECTION_IDS = ['hero', 'experiencia', 'proyectos', 'contacto'];

      const grab = () => {
        STATE.header = document.querySelector('header');
        STATE.hero = document.getElementById('hero');
        STATE.sections = SECTION_IDS.map((id) => document.getElementById(id)).filter(Boolean);
        STATE.links = Array.from(document.querySelectorAll('nav a.nav-link'));
      };

      const setActive = (id) => {
        if (id === STATE.current) return;
        STATE.current = id;
        STATE.links.forEach((a) => {
          const target = a.getAttribute('href')?.split('#')[1];
          if (target === id) a.classList.add('nav-active');
          else a.classList.remove('nav-active');
        });
      };

      const updateHeroState = () => {
        if (!STATE.header) return;
        if (!STATE.hero) {
          STATE.header.classList.remove('nav-over-hero');
          return;
        }
        const r = STATE.hero.getBoundingClientRect();
        const onHero = r.bottom > 64 && r.top < window.innerHeight * 0.5;
        STATE.header.classList.toggle('nav-over-hero', onHero);
      };

      const focusLine = () => window.innerHeight * 0.3;

      const computeActive = () => {
        if (location.pathname.startsWith('/proyectos')) {
          // En páginas de proyectos (lista o detalle) marcamos Proyectos
          setActive('proyectos');
          return;
        }
        const y = focusLine();
        if (!STATE.sections.length) {
          setActive('');
          return;
        }
        const atPageEnd =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 80;
        if (atPageEnd) {
          setActive(STATE.sections[STATE.sections.length - 1].id);
          return;
        }
        let winner = null;
        for (const sec of STATE.sections) {
          const r = sec.getBoundingClientRect();
          if (r.bottom < y) continue;
          const center = r.top + r.height / 2;
          const dist = Math.abs(center - y);
          const weight = 1 / (dist + 1);
          if (!winner || weight > winner.weight) winner = { id: sec.id, weight };
        }
        setActive(winner ? winner.id : '');
      };

      let ticking = false;
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateHeroState();
            computeActive();
            ticking = false;
          });
        }
      };

      const reinit = (hard = false) => {
        grab();
        if (!STATE.header) return; // aún no montó
        if (hard) STATE.current = '';
        onScroll();
      };

      // Eventos núcleo
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => {
        reinit();
      });
      window.addEventListener('pageshow', (e: any) => {
        if (e.persisted) reinit(true);
      });
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) reinit();
      });
      document.addEventListener('astro:after-swap', () => {
        setTimeout(() => reinit(true), 25);
      });

      // Retries progresivos (por si imágenes/layout retrasan hero)
      const scheduleRetries = () => {
        const delays = [40, 120, 320];
        delays.forEach((d) => setTimeout(() => reinit(), d));
      };

      grab();
      reinit(true);
      scheduleRetries();
    }

    initThemeToggleSystem();
  }
</script>
