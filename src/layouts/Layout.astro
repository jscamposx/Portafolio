---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

// Meta y datos globales inline (simplificado)
const siteName = 'Jesús Campos';
const footerNote = 'Creemos experiencias memorables.';
const socialLinks = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/jscamposx' },
	{ label: 'GitHub', href: 'https://github.com/jscamposx' },
	{ label: 'Dribbble', href: 'https://dribbble.com/jscamposx' }
];
const defaultMeta = {
	title: 'Jesús Campos | Diseño y desarrollo web',
	description: 'Portafolio de Jesús Campos: diseño de interfaces, desarrollo front-end y experiencias digitales cuidadas.'
};

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	showNav?: boolean; // permitir ocultar navbar
}

const {
	title = defaultMeta.title,
	description = defaultMeta.description,
	canonical,
	showNav = true
} = Astro.props as Props;
---

<!doctype html>
<html lang="es" class="dark pre-theme">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<script>
        (() => {
          try {
            const pref = localStorage.getItem('theme') || 'system';
            const mq = window.matchMedia('(prefers-color-scheme: dark)');
            const dark = pref === 'dark' || (pref === 'system' && mq.matches);
            const root = document.documentElement;
            if (dark) root.classList.add('dark'); else root.classList.remove('dark');
            root.dataset.theme = pref;
          } catch {}
        })();
      </script>
	</head>
	<body class="min-h-screen bg-transparent text-[var(--color-text)] antialiased">
		<div class="relative">
			<div
				class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-br from-[rgba(192,132,252,0.18)] via-transparent to-[rgba(82,33,145,0.25)] blur-3xl"
				aria-hidden="true">
			</div>

			{showNav && (
				<div transition:persist="global-nav">
					<NavBar />
				</div>
			)}
			{!showNav && (
				<div transition:persist="theme-toggle">
					<ThemeToggle />
				</div>
			)}

			<main class="mx-auto max-w-6xl px-4 sm:px-6 pt-20 pb-12 sm:pt-28 sm:pb-16 lg:pt-36 lg:pb-24" transition:animate="fade">
				<slot />
			</main>

			<footer class="border-t border-[var(--color-border)]">
				<div class="mx-auto flex max-w-6xl flex-col gap-4 sm:gap-6 px-4 sm:px-6 py-8 sm:py-10 sm:flex-row sm:items-center sm:justify-between">
					<p class="text-sm text-[var(--color-text-muted)]">
						© {new Date().getFullYear()} {siteName}. {footerNote}
					</p>
					<nav class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-muted)]" aria-label="Redes sociales">
						{socialLinks.map((social) => (
							<a
								class="transition-colors hover:text-[var(--color-text)]"
								href={social.href}
								target="_blank"
								rel="noreferrer"
							>
								{social.label}
							</a>
						))}
					</nav>
				</div>
			</footer>
		</div>
	</body>
	<script>
		const scrollToHash = () => {
			if (!location.hash) return;
			const target = document.querySelector(location.hash);
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};

		window.queueMicrotask(scrollToHash);
		window.addEventListener('astro:after-swap', scrollToHash);
		window.addEventListener('astro:page-load', scrollToHash);
	</script>
</html>
