---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';

// Meta y datos globales inline (simplificado)
const siteName = 'Jesús Campos';
const socialLinks = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/jscamposx', icon: 'linkedin' },
	{ label: 'GitHub', href: 'https://github.com/jscamposx', icon: 'github' },
	{ label: 'Dribbble', href: 'https://dribbble.com/jscamposx', icon: 'dribbble' }
];
const defaultMeta = {
	title: 'Jesús Campos | Diseño y desarrollo web',
	description: 'Portafolio de Jesús Campos: diseño de interfaces, desarrollo front-end y experiencias digitales cuidadas.'
};

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	showNav?: boolean; // permitir ocultar navbar
}

const {
	title = defaultMeta.title,
	description = defaultMeta.description,
	canonical,
	showNav = true
} = Astro.props as Props;
---

<!doctype html>
<html lang="es" class="dark pre-theme">
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<script>
        (() => {
          try {
            const pref = localStorage.getItem('theme') || 'system';
            const mq = window.matchMedia('(prefers-color-scheme: dark)');
            const dark = pref === 'dark' || (pref === 'system' && mq.matches);
            const root = document.documentElement;
            if (dark) root.classList.add('dark'); else root.classList.remove('dark');
            root.dataset.theme = pref;
          } catch {}
        })();
      </script>
	</head>
	<body class="min-h-screen bg-transparent text-[var(--color-text)] antialiased">
		<div class="relative">
			<div
				class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-br from-[rgba(192,132,252,0.18)] via-transparent to-[rgba(82,33,145,0.25)] blur-3xl"
				aria-hidden="true">
			</div>

			{showNav && (
				<div transition:persist="global-nav">
					<NavBar />
				</div>
			)}
			{!showNav && (
				<div transition:persist="theme-toggle">
					<ThemeToggle />
				</div>
			)}

			<main class="mx-auto max-w-6xl px-4 sm:px-6 pt-20 pb-12 sm:pt-28 sm:pb-16 lg:pt-36 lg:pb-24">
				<slot />
			</main>

			<footer class="border-t border-[var(--color-border)]">
				<div class="mx-auto flex max-w-6xl flex-col gap-4 sm:gap-6 px-4 sm:px-6 py-8 sm:py-10 sm:flex-row sm:items-center sm:justify-between">
					<p class="text-sm text-[var(--color-text-muted)]">
						© {new Date().getFullYear()} {siteName}
					</p>
					<nav class="flex flex-wrap items-center gap-5" aria-label="Redes sociales">
						{socialLinks.map((social) => (
							<a
								class="group flex items-center gap-2 text-sm text-[var(--color-text-muted)] transition-all hover:text-[var(--color-accent)] hover:-translate-y-0.5"
								href={social.href}
								target="_blank"
								rel="noreferrer"
								aria-label={social.label}
							>
								{social.icon === 'linkedin' && (
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
									</svg>
								)}
								{social.icon === 'github' && (
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
									</svg>
								)}
								{social.icon === 'dribbble' && (
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm8.635 8.758c-.33-.097-.953-.283-1.73-.396.18-.715.32-1.43.41-2.113 1.23.85 2.13 2.15 2.55 3.61-.41-.31-.98-.66-1.23-.76v.66zm-1.64-3.854c-.09.683-.24 1.398-.42 2.113-1.42-.33-2.99-.51-4.57-.51-1.05 0-2.08.06-3.07.18.26-.95.58-1.86.95-2.71C13.22 3.665 15.01 4.184 16.995 4.904zM8.5 4.61c-.37.85-.69 1.76-.95 2.71-1.12.17-2.19.44-3.19.79C5.55 6.14 6.85 5.12 8.5 4.61zm-5.1 4.49c1.1-.39 2.27-.68 3.49-.86.32 1.51.78 2.99 1.37 4.41-1.88.85-3.49 2.11-4.67 3.65-.88-1.36-1.4-2.99-1.4-4.75 0-.83.1-1.63.28-2.39l.93-.06zm1.85 9.85c1.12-1.47 2.61-2.65 4.38-3.45.45 1.23.82 2.5 1.1 3.79-1.88.42-3.62 1.17-5.13 2.16-.61-.95-1.05-2.01-1.35-3.14v-.36zm6.75 4.44c-.28-1.29-.65-2.56-1.1-3.79 1.05-.36 2.17-.56 3.35-.56 1.45 0 2.85.26 4.14.73-.54 1.85-1.68 3.43-3.18 4.5-1.07-.29-2.14-.58-3.21-.88zm4.86-.35c1.42-1.01 2.51-2.47 3.03-4.19 1.25.51 2.33 1.25 3.18 2.15-1.29 1.65-3.13 2.87-5.24 3.37l-.97-.33z"/>
									</svg>
								)}
								<span class="sr-only">{social.label}</span>
							</a>
						))}
					</nav>
				</div>
			</footer>
		</div>
	</body>
	<script>
		const scrollToHash = () => {
			if (!location.hash) return;
			const target = document.querySelector(location.hash);
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};

		window.queueMicrotask(scrollToHash);
		window.addEventListener('astro:after-swap', scrollToHash);
		window.addEventListener('astro:page-load', scrollToHash);
	</script>
</html>
